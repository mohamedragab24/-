rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // الملفات المشارَكة داخل الجلسات المباشرة (PDF / صور)
    match /meeting_files/{channel}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 30 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // أعمال المفهمين: الرفع لصاحب الحساب فقط، والقراءة للجميع
    match /portfolio/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 500 * 1024 * 1024;
    }

    // صور البروفايل قيد المراجعة: يرفعها صاحب الحساب، وتنتقل للمسار العام بعد موافقة الإدارة
    match /pending/profiles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '_.*[.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true; }
    function ownsCourse(courseId) { return signedIn() && firestore.get(/databases/(default)/documents/courses/$(courseId)).data.instructorId == request.auth.uid; }
    match /notifications/{allPaths=**} {
      allow read: if true;
      allow write: if admin();
    }
    match /courses/{courseId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if admin() || ownsCourse(courseId);
    }
  }
}
